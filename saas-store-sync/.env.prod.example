# -----------------------------------------------------------------------------
# Production shared template — copy to `.env.prod` (gitignored)
# -----------------------------------------------------------------------------
# Build frontend: cd frontend && VITE_API_URL=/api/v1 npm run build
#
# Where to use this file
# ----------------------
# 1) Main application server (primary — full Docker stack: API, Redis, Celery beat, workers)
#    Compose: docker-compose.prod.yml
#    Start:    docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#    Optional: set DATABASE_URL to a dedicated Postgres host (see below). If unset, the
#    bundled `db` container is used (postgres://…@db:5432/… injected by compose).
#
# 2) United States browser scraper worker (Celery only, queue heavy-us)
#    Compose: docker-compose.us-scraper.prod.yml
#    Start:    docker compose -f docker-compose.us-scraper.prod.yml --env-file .env.prod up -d
#    Set REDIS_URL to the main host broker, e.g. redis://MAIN_APPLICATION_SERVER_IP:6379/0
#    Set DATABASE_URL to your Postgres (same DB the main app uses — often a dedicated EU host).
#
# 3) Australia browser + Vevor feed worker (Celery only, queue heavy-au)
#    Compose: docker-compose.au-scraper.prod.yml
#    Start:    docker compose -f docker-compose.au-scraper.prod.yml --env-file .env.prod up -d
#    Same REDIS_URL / DATABASE_URL pattern as the US worker (Redis on main; Postgres wherever
#    the app uses it). Costco AU stays ingest-only (desktop runner → API), not this queue.
#
# Cross-reference: `.env.example` (production sections).
#
# -----------------------------------------------------------------------------
# Variables — Main application server (docker-compose.prod.yml reads from .env.prod)
# -----------------------------------------------------------------------------
# Database (bundled Postgres on main, or dedicated host for all app + workers)
POSTGRES_DB=your_postgres_database
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
# Optional host publish for remote workers (only if Postgres listens on the main host).
# Restrict firewall to trusted IPs (main, US worker, AU worker). Omit if Postgres is elsewhere.
# POSTGRES_PUBLISH_PORT=5432

# Optional — dedicated Postgres (e.g. EU VPS). When set on the main host, backend + Celery use
# this URL instead of the bundled `db` service URL (compose default remains @db if unset).
# Use URL-encoded credentials if passwords contain @ : / etc.
# DATABASE_URL=postgres://POSTGRES_USER:POSTGRES_PASSWORD@YOUR_POSTGRES_HOST:5432/POSTGRES_DB

# On main, if DATABASE_URL is unset, compose injects:
#   postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
#   redis://redis:6379/0
#
# Optional Redis auth + tuning (main stack): set REDIS_PASSWORD in `.env.prod`, then set
# REDIS_URL=redis://:URL_ENCODED_PASSWORD@redis:6379/0 (same for remote US/AU workers, host IP instead of `redis`).
# Dashboard/API fragment cache (Redis logical DB 1; Celery stays on …/0): USE_REDIS_CACHE=1
#
# Core app (backend, celery_worker_celery / celery_worker_ingest / celery_worker_sync / celery_worker_light, celery_beat):
DEBUG=False
SECURE_SSL_REDIRECT=0
DOMAIN_NAME=yourdomain.com
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,YOUR_MAIN_SERVER_IPV4,backend
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
FRONTEND_URL=https://yourdomain.com
JWT_SECRET=your_long_random_jwt_secret
ENCRYPTION_KEY=your_fernet_encryption_key
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/v1/auth/google/callback/

# Optional / tuning:
# REDIS_PASSWORD=
# REDIS_URL=redis://redis:6379/0
# USE_REDIS_CACHE=1
# SCRAPE_PROGRESS_CACHE_SECONDS=12
# VENDOR_PRICE_RETENTION_DAYS=90
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=120
# PG_CONN_MAX_AGE=60
#   Django DB connection reuse (seconds). Helps remote Postgres latency. Use 0 with PgBouncer (transaction pool).
# CATALOG_ALLOW_INLINE_STORE_WIDE_SCRAPE=0
# HTTP_PORT=80
# HTTPS_PORT=443
# BACKEND_IMAGE=your-registry/saas-store-sync-backend:tag
# CELERY_CELERY_CONCURRENCY=4
# CELERY_INGEST_CONCURRENCY=3
# CELERY_SYNC_CONCURRENCY=2
# CELERY_LIGHT_CONCURRENCY=2
# EBAY_HTTP_FIRST=0
# CATALOG_SCRAPE_CHUNK_SIZE=400
# CATALOG_SCRAPE_RESUME_AFTER_STOP_SECONDS=600
# CATALOG_SCRAPE_STALL_MINUTES=20   # catalog scrape stall window (5–120); wider = fewer false early stops
# CATALOG_POST_SYNC_PENDING_RESET_BATCH=2500   # ProductMapping rows per UPDATE after catalog sync (200–20000)
# CATALOG_POST_SYNC_PENDING_RESET_SLEEP_MS=0   # optional ms pause between batches (0–5000) to yield DB to API
# COSTCO_AU_MIN_REQUEST_GAP_SEC=20
# COSTCO_AU_LOCK_WAIT_SEC=120

# Proxies (optional; Costco AU, generic scrapers) — PROXY_URLS, PROXY_ENDPOINTS, PROXY_*, COSTCO_AU_PROXY_*:
# PROXY_URL=
# PROXY_URLS=
# COSTCO_AU_PROXY_URL=
# COSTCO_AU_PROXY_URLS=
# PROXY_ENDPOINTS=
# PROXY_HOST=
# PROXY_PORT=
# PROXY_USER=
# PROXY_PASS=
# PROXY_SCHEME=http

VITE_API_URL=/api/v1

# -----------------------------------------------------------------------------
# Variables — United States scraper worker ONLY (docker-compose.us-scraper.prod.yml)
# -----------------------------------------------------------------------------
# Required on the US host (compose passes them through):
#   REDIS_URL=redis://MAIN_APPLICATION_SERVER_IP:6379/0
#   DATABASE_URL=postgres://POSTGRES_USER:POSTGRES_PASSWORD@POSTGRES_HOST:5432/POSTGRES_DB
# (POSTGRES_HOST is your real DB — main IPv4 if Postgres is published there, or EU dedicated IP.)
#
# Also pass the same values as on main for:
#   JWT_SECRET  ENCRYPTION_KEY  ALLOWED_HOSTS  SECURE_SSL_REDIRECT
#   CORS_ALLOWED_ORIGINS  FRONTEND_URL
#   GOOGLE_CLIENT_ID  GOOGLE_CLIENT_SECRET  GOOGLE_REDIRECT_URI
#   EBAY_HTTP_FIRST
#   PROXY_URL  PROXY_URLS  PROXY_ENDPOINTS  PROXY_HOST  PROXY_PORT  PROXY_USER  PROXY_PASS  PROXY_SCHEME
#
# Optional:
#   CELERY_US_SCRAPER_CONCURRENCY=2
#   EBAY_HTTP_FIRST=1   # default in compose; HTTP (curl_cffi) before Selenium — much faster for eBay US
#   BACKEND_IMAGE=your-registry/saas-store-sync-backend:tag

# -----------------------------------------------------------------------------
# Variables — Australia scraper worker ONLY (docker-compose.au-scraper.prod.yml)
# -----------------------------------------------------------------------------
# Required on the AU host (same pattern as US):
#   REDIS_URL=redis://MAIN_APPLICATION_SERVER_IP:6379/0
#   DATABASE_URL=postgres://POSTGRES_USER:POSTGRES_PASSWORD@POSTGRES_HOST:5432/POSTGRES_DB
#
# Also pass the same values as on main for:
#   JWT_SECRET  ENCRYPTION_KEY  ALLOWED_HOSTS  SECURE_SSL_REDIRECT
#   CORS_ALLOWED_ORIGINS  FRONTEND_URL
#   GOOGLE_CLIENT_ID  GOOGLE_CLIENT_SECRET  GOOGLE_REDIRECT_URI
#   EBAY_HTTP_FIRST  EBAY_AU_HTTP_FIRST
#   PROXY_*  COSTCO_AU_PROXY_*  COSTCO_AU_MIN_REQUEST_GAP_SEC  COSTCO_AU_LOCK_WAIT_SEC
#   VEVOR_AU_FEED_URL  CATALOG_SCRAPE_CHUNK_SIZE
# VEVOR_AU_FEED_URL=https://ads-feed.s3.us-west-2.amazonaws.com/ads/business/563/vevor-563.xlsx
#
# Optional:
#   CELERY_AU_SCRAPER_CONCURRENCY=2
#   BACKEND_IMAGE=your-registry/saas-store-sync-backend:tag

# -----------------------------------------------------------------------------
# eBay scraper:
#   EBAY_HTTP_FIRST — default 1 = try HTTP (curl_cffi) before Selenium (much faster). Set 0 to force browser-first.
#   EBAY_AU_HTTP_FIRST — ebay.com.au only: unset = follow EBAY_HTTP_FIRST.
#   EBAY_BIN_HYDRATE_MAX_SEC — AU discount polling cap (default 6s). Set 0 to disable extra Selenium polling.
#   EBAY_AU_FAST_SCRAPE — 1 = fast AU path when cookies are set (default on). Set 0 to always use full browser scraper.
#   EBAY_AU_COOKIES_FILE — path to JSON cookie export for ebay.com.au (mount on AU worker; see ebay_au_cookies.json.example).
#   EBAY_AU_COOKIES_JSON — inline cookie JSON array (alternative to file; avoid in shell history).
#   EBAY_AU_PAGE_WAIT_SEC — seconds after driver.get(item) before parse (default 1.2).
# EBAY_HTTP_FIRST=1
# EBAY_AU_FAST_SCRAPE=1
# EBAY_AU_COOKIES_FILE=/app/secrets/ebay_au_cookies.json
# EBAY_AU_PAGE_WAIT_SEC=1.2

# Catalog vendor scrape: split pending rows into parallel Celery tasks (each with its own Amazon/eBay session).
# 0 = legacy single task. Typical: 300–600. Match or exceed chunk count with CELERY_CELERY_CONCURRENCY (default queue).
# CATALOG_SCRAPE_CHUNK_SIZE=400
# CELERY_CELERY_CONCURRENCY=4
# US worker concurrency: CELERY_US_SCRAPER_CONCURRENCY=1 (see file header for two-server URLs).

# Gunicorn worker timeout (seconds). Keep long jobs on Celery; raise only if needed for other endpoints.
# GUNICORN_TIMEOUT=120

# Store-wide scrape in the web worker: leave unset (off when DEBUG=False). Set 1 only for emergency debugging — prefer Celery.
# CATALOG_ALLOW_INLINE_STORE_WIDE_SCRAPE=0

# Optional: pre-built backend image for backend + celery (skip docker compose build)
# BACKEND_IMAGE=youruser/saas-store-sync-backend:latest
# Optional: published ports
# HTTP_PORT=80
# HTTPS_PORT=443

# HEB is ingest-only on the server — no Selenium / no proxies needed here.
# A desktop runner scrapes HEB and POSTs prices to /api/v1/ingest/heb/ using an
# IngestToken (see `python manage.py create_ingest_token --label heb-pc --scopes heb`).
# The server falls back to the latest VendorPrice automatically when HEB rows are
# hit by the catalog scrape task.

# Scraper proxies (used by Costco AU and any other proxy-aware scrapers).
# Precedence: PROXY_URLS > PROXY_ENDPOINTS > PROXY_URL > PROXY_HOST+PORT.
#
# Option A — one URL per entry (comma or newline):
# PROXY_URLS=http://user:pass@host1:port1,http://user:pass@host2:port2
#
# Option B — shared login, many host:port (comma or newline):
# PROXY_ENDPOINTS=host1:port1,host2:port2,host3:port3
# PROXY_USER=
# PROXY_PASS=
# PROXY_SCHEME=http

# Costco AU server scraper (Cloudflare-protected).
#
# Set COSTCO_AU_PROXY_URLS on the AU worker to ALL of your static residential
# AU proxy URLs (comma- or newline-separated). When this var is set, Costco AU
# stores are scraped server-side through the AU worker — same path as Amazon AU
# / eBay AU. When unset, Costco falls back to the legacy desktop ingest API.
#
# Each proxy URL becomes a sticky session for one worker thread (so cookies +
# Cloudflare clearance stay attached to one IP across many requests).
#
# COSTCO_AU_PROXY_URLS=http://user:pass@host1:port,http://user:pass@host2:port,...
# COSTCO_AU_PROXY_URL=http://user:pass@host:port              # single-proxy form
#
# Rate-limit per proxy (default 20s; ~1.5 req/min/proxy is safe with CF).
# COSTCO_AU_MIN_REQUEST_GAP_SEC=20
#
# HTTP retries per URL before rotating to next proxy (default 2).
# COSTCO_AU_HTTP_RETRIES=2
#
# Per-request timeout (default 25s).
# COSTCO_AU_HTTP_TIMEOUT_SEC=25
#
# After a proxy gets a CF block, skip it for this many seconds (default 600).
# COSTCO_AU_BLOCK_COOLDOWN_SEC=600
#
# Opt-in Selenium fallback when HTTP-first fails repeatedly (default 0).
# COSTCO_AU_SELENIUM_FALLBACK=0
#
# Legacy desktop-runner lock (kept for backward compatibility, ignored by server scraper).
# COSTCO_AU_LOCK_WAIT_SEC=120
#
# Single proxy (unchanged):
# PROXY_URL=http://user:pass@host:port
# PROXY_HOST=
# PROXY_PORT=
# PROXY_USER=
# PROXY_PASS=
# PROXY_SCHEME=http

# Walmart Marketplace API v3 (optional defaults; can also be provided per-store via Store.api_token JSON)
# WALMART_CLIENT_ID=
# WALMART_CLIENT_SECRET=
# WALMART_CONSUMER_ID=
# WALMART_CHANNEL_TYPE=
# WALMART_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# --- Debug: catalog server scrape progress (curl) ---
# The path segment <store_pk> MUST be a real UUID (e.g. from DevTools → Network on /products/
# or SELECT id FROM stores_store WHERE name=...). Literal placeholders like "STORE_UUID" return 404.
# OAuth: DevTools → Application → localStorage → access_token
#
#   export ACCESS_TOKEN='paste_jwt_here'
#   export STORE_UUID='xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx'
#   curl -sS -H "Authorization: Bearer $ACCESS_TOKEN" \
#     "https://wesolucions.com/api/v1/stores/$STORE_UUID/catalog/scrape/progress/"
#
# Expect JSON with key server_celery_scrape (not HTML). If you see HTML Not Found, fix the UUID in the URL.
