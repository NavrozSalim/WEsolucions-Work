# -----------------------------------------------------------------------------
# Local development environment
# -----------------------------------------------------------------------------
# Copy this file to `.env` in this folder (gitignored).
# Start: docker compose up -d
#
# -----------------------------------------------------------------------------
# Production — Main application server (full stack)
# -----------------------------------------------------------------------------
# Host role: primary server (web app, database, Redis, Celery beat + default workers).
# File on disk: `.env.prod` next to `docker-compose.prod.yml`.
# Deploy: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# Django and Celery get REDIS_URL from `docker-compose.prod.yml` (redis service).
# DATABASE_URL defaults to postgres://…@db:5432/… from POSTGRES_*; optional DATABASE_URL
# in `.env.prod` overrides for a dedicated Postgres host (see `.env.prod.example`).
#
# Celery worker queues on this host: celery, ingest, light (AU heavy queue runs on AU VPS).
#
# --- docker-compose.prod.yml variable names (set in `.env.prod`; see `.env.prod.example`) ---
# POSTGRES_DB  POSTGRES_USER  POSTGRES_PASSWORD
# JWT_SECRET  ENCRYPTION_KEY  ALLOWED_HOSTS  DOMAIN_NAME  DEBUG  SECURE_SSL_REDIRECT
# CORS_ALLOWED_ORIGINS  FRONTEND_URL  (defaults use DOMAIN_NAME if unset)
# GOOGLE_CLIENT_ID  GOOGLE_CLIENT_SECRET  GOOGLE_REDIRECT_URI
# GUNICORN_TIMEOUT  CATALOG_ALLOW_INLINE_STORE_WIDE_SCRAPE  VITE_API_URL
# EBAY_HTTP_FIRST  CELERY_WORKER_CONCURRENCY  CATALOG_SCRAPE_CHUNK_SIZE
# CATALOG_SCRAPE_RESUME_AFTER_STOP_SECONDS — seconds after Stop to auto re-queue server scrape for remaining Pending rows (0 = off). Default 600.
# HTTP_PORT  HTTPS_PORT  BACKEND_IMAGE
# PROXY_URL  PROXY_URLS  PROXY_ENDPOINTS  PROXY_HOST  PROXY_PORT  PROXY_USER  PROXY_PASS  PROXY_SCHEME
# COSTCO_AU_PROXY_URL  COSTCO_AU_PROXY_URLS  COSTCO_AU_MIN_REQUEST_GAP_SEC  COSTCO_AU_LOCK_WAIT_SEC
# Optional on main: DATABASE_URL=postgres://USER:PASS@HOST:5432/DB (dedicated Postgres).
#
# -----------------------------------------------------------------------------
# Production — United States browser scraper worker (Celery only)
# -----------------------------------------------------------------------------
# Host role: secondary server; runs only the US scrape queue (`heavy-us`).
# File on disk: `.env.prod` next to `docker-compose.us-scraper.prod.yml`.
# Deploy: docker compose -f docker-compose.us-scraper.prod.yml --env-file .env.prod up -d
#
# Copy the same variables as the main application server, then add (or replace
# with) explicit URLs. Use the main server’s public IP or VPN hostname — not
# `db` or `redis` (those names exist only inside the main Docker network):
#
#   REDIS_URL=redis://MAIN_APPLICATION_SERVER_IP:6379/0
#   DATABASE_URL=postgres://POSTGRES_USER:POSTGRES_PASSWORD@POSTGRES_HOST:5432/POSTGRES_DB
#
# POSTGRES_HOST is wherever Postgres listens (main IP if published there, or dedicated DB host).
#
# On the main application server, allow inbound Postgres and Redis from this
# worker’s public IP (US_SCRAPER_WORKER_IP): firewall, PostgreSQL pg_hba.conf, Redis bind/security.
#
# Optional: CELERY_US_SCRAPER_CONCURRENCY=1
#
# --- Environment variables (United States worker — docker-compose.us-scraper.prod.yml) ---
# Required (compose reads from .env.prod; not auto-built):
#   DATABASE_URL
#   REDIS_URL
#   JWT_SECRET
#   ENCRYPTION_KEY
#   ALLOWED_HOSTS
#   GOOGLE_CLIENT_ID
#   GOOGLE_CLIENT_SECRET
#   GOOGLE_REDIRECT_URI
# Optional / defaults:
#   SECURE_SSL_REDIRECT
#   CORS_ALLOWED_ORIGINS
#   FRONTEND_URL
#   EBAY_HTTP_FIRST
#   PROXY_URL  PROXY_URLS  PROXY_ENDPOINTS  PROXY_HOST  PROXY_PORT  PROXY_USER  PROXY_PASS  PROXY_SCHEME
#   CELERY_US_SCRAPER_CONCURRENCY
#   BACKEND_IMAGE
#
# -----------------------------------------------------------------------------
# Production — Australia browser + Vevor feed worker (Celery only)
# -----------------------------------------------------------------------------
# Host role: AU-region VPS; runs queue `heavy-au` (Amazon AU, eBay AU, run_vevor_au_ingest).
# File: `.env.prod` next to `docker-compose.au-scraper.prod.yml`.
# Deploy: docker compose -f docker-compose.au-scraper.prod.yml --env-file .env.prod up -d
# Same REDIS_URL / DATABASE_URL pattern as the US worker; see `.env.prod.example` AU section.
#
# --- Environment variables (Main application server — see .env.prod.example) ---
# docker-compose.prod.yml supplies REDIS_URL and default DATABASE_URL from POSTGRES_* unless
# DATABASE_URL is set in `.env.prod`.
# -----------------------------------------------------------------------------

POSTGRES_DB=saas_sync
POSTGRES_USER=saas
POSTGRES_PASSWORD=change_me_strong_password

POSTGRES_PORT=5433
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3001

REDIS_URL=redis://localhost:6379/0

DEBUG=True
JWT_SECRET=replace_with_random_hex_or_string
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
FRONTEND_URL=http://localhost:3001

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace_with_fernet_key

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback/

# Browser hits backend on host port (not docker service name)
VITE_API_URL=http://localhost:8000/api/v1

# Walmart Marketplace API v3 (optional defaults; can also be provided per-store via Store.api_token JSON)
# WALMART_CLIENT_ID=
# WALMART_CLIENT_SECRET=
# WALMART_CONSUMER_ID=
# WALMART_CHANNEL_TYPE=
# WALMART_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
