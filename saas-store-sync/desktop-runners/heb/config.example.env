# Copy to .env and fill in (desktop-runners/heb/.env)

# Required — export from Chrome after visiting heb.com + a product page
COOKIES_FILE=cookies.json

# Required — from: python manage.py create_ingest_token --label heb-pc --scopes heb
API_BASE_URL=https://your-app.example.com/api/v1
INGEST_TOKEN=your_bearer_token_here

# Optional tuning
POLL_INTERVAL_SEC=30
MIN_GAP_SEC=15
URL_TIMEOUT_SEC=20
MAX_RETRIES=2
HEADLESS=0
# Leave blank to auto-detect from installed Chrome (Windows registry)
CHROME_VERSION_MAIN=

# Parallel chunk-pool poller
POLLER_WORKERS=10
POLLER_CHUNK_SIZE=25
POLLER_UPLOAD_EVERY=120
POLLER_CANCEL_CHECK_EVERY=5
